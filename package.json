{
  "name": "armorial",
  "version": "0.4.0",
  "description": "Design-system-aware IconPark selection and SVG policy kernel for humans and AI agents.",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tetracoralla/armorial.git"
  },
  "bugs": {
    "url": "https://github.com/tetracoralla/armorial/issues"
  },
  "homepage": "https://tetracoralla.github.io/armorial/",
  "engines": {
    "node": ">=22.0.0"
  },
  "bin": {
    "armorial": "./dist/adapters/cli.js",
    "armorial-mcp": "./dist/adapters/mcp.js",
    "armorial-ui": "./dist/adapters/web-server.js",
    "icon-svg-select": "./dist/adapters/cli.js",
    "icon-svg-select-mcp": "./dist/adapters/mcp.js",
    "icon-svg-select-ui": "./dist/adapters/web-server.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    ".codex-plugin",
    ".mcp.json",
    "skills",
    "dist",
    "figma-plugin/manifest.json",
    "figma-plugin/dist",
    "figma-plugin/THIRD_PARTY_NOTICES.txt",
    "!dist/**/*.map",
    "icon-policy.schema.json",
    "icon-policy.example.json",
    "NOTICE"
  ],
  "scripts": {
    "build": "npm run build:web && npm run build:mcp-app && npm run build:node && npm run build:figma",
    "build:node": "tsc -p tsconfig.build.json",
    "build:web": "vite build",
    "build:pages": "ARMORIAL_PAGES=1 vite build",
    "build:mcp-app": "ICON_MCP_APP=1 vite build",
    "build:figma": "npm run build:figma:ui && npm run build:figma:main",
    "build:figma:ui": "FIGMA_BUILD_TARGET=ui vite build --config vite.figma.config.ts",
    "build:figma:main": "FIGMA_BUILD_TARGET=main vite build --config vite.figma.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.web.json --noEmit && tsc -p tsconfig.figma-ui.json --noEmit && tsc -p tsconfig.figma.json --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "schema:generate": "node --import tsx scripts/generate-policy-schema.ts",
    "schema:check": "node --import tsx scripts/check-policy-schema.ts",
    "runtime:probe": "node scripts/probe-built-runtime.mjs",
    "figma:probe": "node scripts/probe-figma-build.mjs",
    "check": "npm run typecheck && npm test && npm run schema:check && npm run build && npm run runtime:probe && npm run figma:probe && npm run pages:check",
    "pages:check": "npm run build:pages && node --import tsx scripts/check-pages-catalog.ts && node scripts/probe-pages-build.mjs",
    "pages:deployment:check": "node scripts/check-pages-deployment.mjs",
    "prepack": "npm run build",
    "plugin:stage": "node --import tsx scripts/stage-plugin.ts",
    "plugin:check": "npm run plugin:stage && node --import tsx scripts/probe-staged-plugin.ts",
    "start:mcp": "node dist/adapters/mcp.js",
    "start:ui": "node dist/adapters/web-server.js",
    "ui:e2e": "npm run build && playwright test"
  },
  "dependencies": {
    "@icon-park/svg": "1.4.2",
    "@modelcontextprotocol/ext-apps": "1.7.5",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@noble/hashes": "2.3.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@figma/plugin-typings": "1.134.0",
    "@playwright/test": "1.62.1",
    "@types/node": "^24.0.0",
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.7",
    "@vitejs/plugin-react": "5.0.2",
    "ajv": "^8.20.0",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "vite": "7.3.6",
    "vite-plugin-singlefile": "2.3.0"
  }
}
