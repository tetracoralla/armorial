{
  "$id": "https://icon-svg-select.local/icon-policy.schema.json",
  "title": "Icon SVG Select Policy",
  "description": "Executable IconPark rendering and semantic-selection policy.",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 1
    },
    "collections": {
      "minItems": 1,
      "maxItems": 1,
      "type": "array",
      "items": {
        "$ref": "#/$defs/__schema0"
      }
    },
    "defaults": {
      "type": "object",
      "properties": {
        "theme": {
          "$ref": "#/$defs/__schema1"
        },
        "size": {
          "type": "integer",
          "minimum": 8,
          "maximum": 512
        },
        "strokeWidth": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 16,
          "description": "Final visible stroke width in CSS pixels at the configured icon size."
        },
        "strokeLinecap": {
          "$ref": "#/$defs/__schema2"
        },
        "strokeLinejoin": {
          "$ref": "#/$defs/__schema3"
        },
        "colors": {
          "type": "object",
          "properties": {
            "primary": {
              "$ref": "#/$defs/__schema4"
            },
            "secondary": {
              "$ref": "#/$defs/__schema4"
            },
            "innerStroke": {
              "$ref": "#/$defs/__schema4"
            },
            "innerFill": {
              "$ref": "#/$defs/__schema4"
            }
          },
          "required": [
            "primary",
            "secondary",
            "innerStroke",
            "innerFill"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "theme",
        "size",
        "strokeWidth",
        "strokeLinecap",
        "strokeLinejoin",
        "colors"
      ],
      "additionalProperties": false
    },
    "contexts": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/__schema5"
      },
      "additionalProperties": {
        "$ref": "#/$defs/__schema6"
      },
      "maxProperties": 32
    },
    "selections": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/__schema7"
      },
      "additionalProperties": {
        "$ref": "#/$defs/__schema8"
      },
      "maxProperties": 256
    }
  },
  "required": [
    "version",
    "collections",
    "defaults",
    "contexts",
    "selections"
  ],
  "additionalProperties": false,
